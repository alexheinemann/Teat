<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Alex Heinemann | Coming Soon</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Goldener Farbverlauf für die Schrift */
        .gold-text {
            background: linear-gradient(to bottom right, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            color: transparent;
        }

        /* Der Hologramm-Overlay-Effekt */
        #hologram-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none; /* Klicks gehen hindurch */
            opacity: 0; /* Startet unsichtbar */
            transition: opacity 0.5s ease;
            /* Ein feines, glitzerndes Rauschen/Gitter als Basis */
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0) 80%),
                url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAAECAYAAACp8Z5+AAAAIklEQVQIW2NkQAKrVq36z8gAFWNgYGBkgAsgA7AGFBUV/wMAXCwCBb5vP3UAAAAASUVORK5CYII=');
            background-repeat: repeat;
            z-index: 10;
        }
    </style>
</head>
<body class="bg-black text-white font-sans min-h-screen flex flex-col items-center justify-center p-6 overflow-hidden">

    <div id="hologram-overlay"></div>

    <div class="text-center z-20 relative">
        <h1 class="text-6xl md:text-8xl font-extrabold tracking-tighter gold-text mb-4">
            COMING SOON
        </h1>
        <p class="text-zinc-500 text-xl tracking-widest uppercase mb-12">
            Alex Heinemann
        </p>

        <button id="activate-gyro" class="bg-zinc-800 text-zinc-300 px-6 py-3 rounded-full text-sm border border-zinc-700 hover:bg-zinc-700 transition-all flex items-center gap-2 mx-auto">
            <span>✨</span> Hologramm-Effekt aktivieren
        </button>
        
        <p id="gyro-status" class="text-xs text-zinc-700 mt-4"></p>
    </div>

    <script>
        const overlay = document.getElementById('hologram-overlay');
        const button = document.getElementById('activate-gyro');
        const status = document.getElementById('gyro-status');

        // Funktion, die den Effekt basierend auf den Sensordaten berechnet
        function handleOrientation(event) {
            // Beta: Kippen nach vorn/hinten (-180 bis 180)
            // Gamma: Kippen nach links/rechts (-90 bis 90)
            let beta = event.beta;
            let gamma = event.gamma;

            // Werte normalisieren für CSS-Hintergrundposition (-50 bis 150)
            let xPos = (gamma + 90) / 180 * 200 - 50;
            let yPos = (beta + 180) / 360 * 200 - 50;

            // Werte für Farbverschiebung normalisieren (0 bis 360)
            let hueShift = (gamma + 90) + (beta + 180) % 360;

            // Den CSS-Effekt anwenden:
            // 1. Position des Glitzerns verschieben
            // 2. Farbe leicht anpassen (Hologramm-Shimmer)
            overlay.style.backgroundPosition = `${xPos}% ${yPos}%`;
            overlay.style.filter = `hue-rotate(${hueShift}deg) brightness(1.2)`;
        }

        // Funktion zum Anfragen der Berechtigung (iOS spezifisch)
        function requestGyroPermission() {
            // Prüfen, ob die API existiert (iOS 13+)
            if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
                
                DeviceOrientationEvent.requestPermission()
                    .then(response => {
                        if (response == 'granted') {
                            startEffect();
                        } else {
                            status.innerText = "Zugriff verweigert.";
                        }
                    })
                    .catch(console.error);
            } else {
                // Nicht-iOS Geräte oder ältere Versionen
                startEffect();
                status.innerText = "Sensor gestartet (keine Berechtigung nötig).";
            }
        }

        // Effekt starten
        function startEffect() {
            window.addEventListener('deviceorientation', handleOrientation);
            overlay.style.opacity = '1'; // Effekt sichtbar machen
            button.style.display = 'none'; // Button verstecken
            status.innerText = "Hologramm aktiv! Bewege dein Phone.";
        }

        // Event Listener für den Button
        button.addEventListener('click', requestGyroPermission);
    </script>
</body>
</html>
